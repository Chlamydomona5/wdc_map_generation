{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "display_name": {
      "type": "string"
    },
    "reward_recipe_id": {
      "type": "string"
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "anchor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "node",
        "anchor"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "purpose": {
            "type": "string"
          },
          "blueprints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "weight": {
                  "type": "number",
                  "minimum": 0
                },
                "max_instances": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id"
              ]
            }
          },
          "min_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "max_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "rotations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/rotation"
            }
          },
          "rotation": {
            "$ref": "#/$defs/rotation"
          },
          "position": {
            "$ref": "#/$defs/cell"
          }
        },
        "required": [
          "id",
          "blueprints"
        ]
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "mode": {
            "enum": [
              "pair",
              "fan_out",
              "chain"
            ]
          },
          "from": {
            "$ref": "#/$defs/endpoint"
          },
          "to": {
            "$ref": "#/$defs/endpoint"
          },
          "required": {
            "type": "boolean"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "style": {
            "enum": [
              "direct",
              "corridor"
            ]
          },
          "max_length_cells": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "width_cells": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "directions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                {
                  "x": 1,
                  "y": 0
                },
                {
                  "x": 0,
                  "y": 1
                },
                {
                  "x": -1,
                  "y": 0
                },
                {
                  "x": 0,
                  "y": -1
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "from",
          "to"
        ]
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "id",
    "nodes",
    "primary"
  ],
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "rotation": {
      "type": "integer",
      "enum": [
        0,
        90,
        180,
        270
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "port": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "group": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "instance": {
          "enum": [
            "first",
            "last"
          ]
        }
      },
      "required": [
        "node"
      ],
      "oneOf": [
        {
          "required": [
            "port"
          ],
          "not": {
            "required": [
              "group"
            ]
          }
        },
        {
          "required": [
            "group"
          ],
          "not": {
            "required": [
              "port"
            ]
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wdc.local/schemas/poi_composition.schema.json",
  "title": "POI 组合规则"
}
