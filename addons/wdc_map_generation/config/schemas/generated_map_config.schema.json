{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WDC Generated Map Config",
  "type": "object",
  "required": ["schema_version", "id", "display_name", "map", "terrain", "minerals", "poi_generation"],
  "allOf": [
    {
      "if": { "required": ["region_layout"] },
      "then": {
        "properties": {
          "schema_version": { "const": 2 }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "map": {
      "type": "object",
      "required": ["width_cells", "height_cells", "seed"],
      "properties": {
        "width_cells": { "type": "integer", "minimum": 8 },
        "height_cells": { "type": "integer", "minimum": 8 },
        "cell_size_m": { "type": "number", "exclusiveMinimum": 0 },
        "seed": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["random", "fixed"] },
            "fixed_value": { "type": "integer", "minimum": 0 }
          }
        },
        "player_spawn": {
          "type": "object",
          "properties": {
            "count": { "type": "integer", "minimum": 0, "default": 1 },
            "layer_id": { "enum": ["outer"] },
            "edge_margin_cells": { "type": "integer", "minimum": 0 },
            "min_distance_between_spawns_cells": { "type": "number", "minimum": 0 },
            "clearance_radius_cells": { "type": "integer", "minimum": 0 },
            "min_clearance_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "extraction_sites": {
          "type": "object",
          "properties": {
            "count": { "type": "integer", "minimum": 0, "default": 1 },
            "layer_distribution": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["layer_id", "ratio"],
                "properties": {
                  "layer_id": { "enum": ["inner", "middle"] },
                  "ratio": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            },
            "min_distance_from_player_spawns_cells": { "type": "number", "minimum": 0 },
            "min_distance_between_sites_cells": { "type": "number", "minimum": 0 },
            "edge_margin_cells": { "type": "integer", "minimum": 0 },
            "clearance_radius_cells": { "type": "integer", "minimum": 0 },
            "min_clearance_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "map_layers": {
      "type": "array",
      "description": "Three concentric map layers resolved from the map geometry center.",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "enum": ["inner", "middle", "outer"] },
          "max_radius_cells": { "type": "number", "minimum": 0 },
          "max_radius_ratio": { "type": "number", "minimum": 0 },
          "stone_max_hit_points": { "type": "integer", "minimum": 1 },
          "mineral_budget_weight": { "type": "number", "minimum": 0 },
          "poi_budget_weight": { "type": "number", "minimum": 0 },
          "trap_budget_weight": { "type": "number", "minimum": 0 },
          "monster_budget_weight": { "type": "number", "minimum": 0 },
          "room_content_danger_multiplier": { "type": "number", "minimum": 0 },
          "boundary_noise_amplitude_cells": { "type": "number", "minimum": 0 },
          "boundary_noise_scale_cells": { "type": "number", "minimum": 1 },
          "boundary_noise_octaves": { "type": "integer", "minimum": 1, "maximum": 6 },
          "boundary_noise_persistence": { "type": "number", "minimum": 0, "maximum": 1 },
          "boundary_noise_seed_offset": { "type": "integer" }
        },
        "anyOf": [
          { "required": ["max_radius_cells"] },
          { "required": ["max_radius_ratio"] }
        ]
      }
    },
    "region_layout": { "$ref": "#/$defs/pveFourRegionLayout" },
    "terrain": { "type": "object" },
    "minerals": { "type": "object" },
    "poi_generation": { "type": "object" },
    "monster_generation": { "type": "object" },
    "debug": { "type": "object" }
  },
  "$defs": {
    "corePoi": {
      "type": "object",
      "required": ["template_id", "max_center_offset_cells"],
      "properties": {
        "template_id": { "type": "string", "minLength": 1 },
        "max_center_offset_cells": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "regularRegion": {
      "type": "object",
      "required": ["id", "display_name", "content_profile_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "content_profile_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "highRegion": {
      "type": "object",
      "required": ["id", "display_name", "layout_profile_id", "content_profile_id", "core_poi"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "layout_profile_id": { "type": "string", "minLength": 1 },
        "content_profile_id": { "type": "string", "minLength": 1 },
        "core_poi": { "$ref": "#/$defs/corePoi" }
      },
      "additionalProperties": false
    },
    "bossRegion": {
      "type": "object",
      "required": ["id", "display_name", "layout_profile_id", "content_profile_id", "core_poi", "encounter_profile_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "layout_profile_id": { "type": "string", "minLength": 1 },
        "content_profile_id": { "type": "string", "minLength": 1 },
        "core_poi": { "$ref": "#/$defs/corePoi" },
        "encounter_profile_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "pveFourRegionLayout": {
      "type": "object",
      "required": ["mode", "regular", "high_1", "high_2", "boss"],
      "properties": {
        "mode": { "const": "pve_four_region_v1" },
        "regular": { "$ref": "#/$defs/regularRegion" },
        "high_1": { "$ref": "#/$defs/highRegion" },
        "high_2": { "$ref": "#/$defs/highRegion" },
        "boss": { "$ref": "#/$defs/bossRegion" }
      },
      "additionalProperties": false
    }
  }
}
