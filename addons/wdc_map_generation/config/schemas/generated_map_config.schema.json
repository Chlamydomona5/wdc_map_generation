{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WDC Generated Map Config",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "display_name",
    "map",
    "terrain",
    "minerals",
    "poi_generation"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "region_layout"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "enum": [
              2,
              3
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "region_layout"
        ],
        "properties": {
          "region_layout": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "pve_four_region_v1"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "region_generation"
        ],
        "properties": {
          "region_generation": {
            "$ref": "#/$defs/regionGeneration"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "poi_generation": {
            "properties": {
              "poi_types": {
                "contains": {
                  "required": [
                    "layout_kind"
                  ],
                  "properties": {
                    "layout_kind": {
                      "const": "authored_rooms"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "region_layout"
        ],
        "properties": {
          "schema_version": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "region_layout"
        ],
        "properties": {
          "region_layout": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "poi_only_v1"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "poi_only",
          "region_generation"
        ],
        "properties": {
          "schema_version": {
            "const": 3
          },
          "region_generation": {
            "$ref": "#/$defs/poiOnlyGeneration"
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "map": {
      "type": "object",
      "required": [
        "width_cells",
        "height_cells",
        "seed"
      ],
      "properties": {
        "width_cells": {
          "type": "integer",
          "minimum": 8
        },
        "height_cells": {
          "type": "integer",
          "minimum": 8
        },
        "cell_size_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seed": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "random",
                "fixed"
              ]
            },
            "fixed_value": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "player_spawn": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "default": 1
            },
            "layer_id": {
              "enum": [
                "outer"
              ]
            },
            "edge_margin_cells": {
              "type": "integer",
              "minimum": 0
            },
            "min_distance_between_spawns_cells": {
              "type": "number",
              "minimum": 0
            },
            "clearance_radius_cells": {
              "type": "integer",
              "minimum": 0
            },
            "min_clearance_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "extraction_sites": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "default": 1
            },
            "layer_distribution": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "layer_id",
                  "ratio"
                ],
                "properties": {
                  "layer_id": {
                    "enum": [
                      "inner",
                      "middle"
                    ]
                  },
                  "ratio": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            },
            "min_distance_from_player_spawns_cells": {
              "type": "number",
              "minimum": 0
            },
            "min_distance_between_sites_cells": {
              "type": "number",
              "minimum": 0
            },
            "edge_margin_cells": {
              "type": "integer",
              "minimum": 0
            },
            "clearance_radius_cells": {
              "type": "integer",
              "minimum": 0
            },
            "min_clearance_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "map_layers": {
      "type": "array",
      "description": "Three concentric map layers resolved from the map geometry center.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "enum": [
              "inner",
              "middle",
              "outer"
            ]
          },
          "max_radius_cells": {
            "type": "number",
            "minimum": 0
          },
          "max_radius_ratio": {
            "type": "number",
            "minimum": 0
          },
          "stone_max_hit_points": {
            "type": "integer",
            "minimum": 1
          },
          "mineral_budget_weight": {
            "type": "number",
            "minimum": 0
          },
          "poi_budget_weight": {
            "type": "number",
            "minimum": 0
          },
          "trap_budget_weight": {
            "type": "number",
            "minimum": 0
          },
          "monster_budget_weight": {
            "type": "number",
            "minimum": 0
          },
          "room_content_danger_multiplier": {
            "type": "number",
            "minimum": 0
          },
          "boundary_noise_amplitude_cells": {
            "type": "number",
            "minimum": 0
          },
          "boundary_noise_scale_cells": {
            "type": "number",
            "minimum": 1
          },
          "boundary_noise_octaves": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "boundary_noise_persistence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "boundary_noise_seed_offset": {
            "type": "integer"
          }
        },
        "anyOf": [
          {
            "required": [
              "max_radius_cells"
            ]
          },
          {
            "required": [
              "max_radius_ratio"
            ]
          }
        ]
      }
    },
    "region_layout": {
      "oneOf": [
        {
          "$ref": "#/$defs/pveFourRegionLayout"
        },
        {
          "$ref": "#/$defs/poiOnlyLayout"
        }
      ]
    },
    "region_generation": {
      "oneOf": [
        {
          "$ref": "#/$defs/regionGeneration"
        },
        {
          "$ref": "#/$defs/poiOnlyGeneration"
        }
      ]
    },
    "terrain": {
      "type": "object"
    },
    "minerals": {
      "type": "object"
    },
    "poi_generation": {
      "type": "object",
      "properties": {
        "poi_types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "core_metadata": {
                "$ref": "#/$defs/corePoiMetadata"
              },
              "layout_kind": {
                "enum": [
                  "legacy_rooms",
                  "authored_rooms"
                ]
              },
              "composition_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "layout_kind"
                  ],
                  "properties": {
                    "layout_kind": {
                      "const": "authored_rooms"
                    }
                  }
                },
                "then": {
                  "required": [
                    "composition_id"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "main_room"
                        ]
                      },
                      {
                        "required": [
                          "sub_rooms"
                        ]
                      },
                      {
                        "required": [
                          "connectivity"
                        ]
                      },
                      {
                        "required": [
                          "core_metadata"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "monster_generation": {
      "type": "object"
    },
    "debug": {
      "type": "object"
    },
    "poi_only": {
      "$ref": "#/$defs/poiOnlyConfig"
    }
  },
  "$defs": {
    "cellOffset": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "corePoiMetadata": {
      "type": "object",
      "required": [
        "reward_gate_cells",
        "reward_object_cells",
        "reward_recipe_id"
      ],
      "properties": {
        "reward_gate_cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cellOffset"
          }
        },
        "reward_object_cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cellOffset"
          }
        },
        "reward_recipe_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sizeCells": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 1
        },
        "y": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "regionLayoutProfile": {
      "type": "object",
      "required": [
        "id",
        "shape_algorithm",
        "min_size_cells",
        "max_size_cells",
        "edge_margin_cells",
        "regular_moat_cells",
        "core_poi_padding_cells",
        "seed_salt",
        "max_attempts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "shape_algorithm": {
          "enum": [
            "rectangle",
            "rounded_rectangle",
            "noisy_ellipse"
          ]
        },
        "min_size_cells": {
          "$ref": "#/$defs/sizeCells"
        },
        "max_size_cells": {
          "$ref": "#/$defs/sizeCells"
        },
        "edge_margin_cells": {
          "type": "integer",
          "minimum": 1
        },
        "regular_moat_cells": {
          "type": "integer",
          "minimum": 1
        },
        "core_poi_padding_cells": {
          "type": "integer",
          "minimum": 0
        },
        "seed_salt": {
          "type": "integer"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "mineralProfileEntry": {
      "type": "object",
      "required": [
        "cluster_type_id",
        "weight",
        "value_cost"
      ],
      "properties": {
        "cluster_type_id": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "value_cost": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "poiProfileEntry": {
      "type": "object",
      "required": [
        "template_id",
        "weight"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "roomContentProfileEntry": {
      "type": "object",
      "required": [
        "content_kind",
        "weight",
        "value_cost"
      ],
      "properties": {
        "content_kind": {
          "enum": [
            "monster_pack",
            "nest",
            "camp"
          ]
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "value_cost": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "trapProfileEntry": {
      "type": "object",
      "required": [
        "trap_kind",
        "weight"
      ],
      "properties": {
        "trap_kind": {
          "enum": [
            "spike",
            "explosive_ore_chain",
            "arrow_slit",
            "mimic_ore",
            "pressure_plate"
          ]
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "monsterSiteProfileEntry": {
      "type": "object",
      "required": [
        "spawn_template_id",
        "weight"
      ],
      "properties": {
        "spawn_template_id": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "nestProfileEntry": {
      "type": "object",
      "required": [
        "nest_template_id",
        "weight"
      ],
      "properties": {
        "nest_template_id": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "campProfileEntry": {
      "type": "object",
      "required": [
        "camp_id",
        "weight",
        "value_cost"
      ],
      "properties": {
        "camp_id": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "value_cost": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "mineralCountProfile": {
      "type": "object",
      "required": [
        "count_unit",
        "target_count",
        "minimum_count",
        "entries"
      ],
      "properties": {
        "count_unit": {
          "const": "site"
        },
        "target_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mineralProfileEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "poiCountProfile": {
      "type": "object",
      "required": [
        "count_unit",
        "target_count",
        "minimum_count",
        "entries"
      ],
      "properties": {
        "count_unit": {
          "const": "instance"
        },
        "target_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/poiProfileEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "roomContentCountProfile": {
      "type": "object",
      "required": [
        "count_unit",
        "target_count",
        "minimum_count",
        "entries"
      ],
      "properties": {
        "count_unit": {
          "const": "placement_site"
        },
        "target_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roomContentProfileEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "trapCountProfile": {
      "type": "object",
      "required": [
        "count_unit",
        "target_count",
        "minimum_count",
        "entries"
      ],
      "properties": {
        "count_unit": {
          "const": "instance"
        },
        "target_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trapProfileEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "monsterSiteCountProfile": {
      "type": "object",
      "required": [
        "count_unit",
        "target_count",
        "minimum_count",
        "entries"
      ],
      "properties": {
        "count_unit": {
          "const": "spawn_site"
        },
        "target_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/monsterSiteProfileEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "nestCountProfile": {
      "type": "object",
      "required": [
        "count_unit",
        "target_count",
        "minimum_count",
        "entries"
      ],
      "properties": {
        "count_unit": {
          "const": "instance"
        },
        "target_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nestProfileEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "campCountProfile": {
      "type": "object",
      "required": [
        "count_unit",
        "target_count",
        "minimum_count",
        "entries"
      ],
      "properties": {
        "count_unit": {
          "const": "encounter"
        },
        "target_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/campProfileEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "wallDurability": {
      "type": "object",
      "required": [
        "ordinary_max_hit_points",
        "mineral_max_hit_points",
        "poi_max_hit_points"
      ],
      "properties": {
        "ordinary_max_hit_points": {
          "type": "integer",
          "minimum": 1
        },
        "mineral_max_hit_points": {
          "type": "integer",
          "minimum": 1
        },
        "poi_max_hit_points": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "regionContentProfile": {
      "type": "object",
      "required": [
        "id",
        "wall_durability",
        "mineral_value_budget",
        "reward_value_budget",
        "minerals",
        "pois",
        "room_contents",
        "traps",
        "monster_sites",
        "nests",
        "camps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "wall_durability": {
          "$ref": "#/$defs/wallDurability"
        },
        "mineral_value_budget": {
          "type": "integer",
          "minimum": 0
        },
        "reward_value_budget": {
          "type": "integer",
          "minimum": 0
        },
        "minerals": {
          "$ref": "#/$defs/mineralCountProfile"
        },
        "pois": {
          "$ref": "#/$defs/poiCountProfile"
        },
        "room_contents": {
          "$ref": "#/$defs/roomContentCountProfile"
        },
        "traps": {
          "$ref": "#/$defs/trapCountProfile"
        },
        "monster_sites": {
          "$ref": "#/$defs/monsterSiteCountProfile"
        },
        "nests": {
          "$ref": "#/$defs/nestCountProfile"
        },
        "camps": {
          "$ref": "#/$defs/campCountProfile"
        },
        "furnishings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count_unit",
            "target_count",
            "minimum_count",
            "entries"
          ],
          "properties": {
            "count_unit": {
              "const": "instance"
            },
            "target_count": {
              "type": "integer",
              "minimum": 0
            },
            "minimum_count": {
              "type": "integer",
              "minimum": 0
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content_id",
                  "weight",
                  "value_cost"
                ],
                "properties": {
                  "content_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0
                  },
                  "value_cost": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "torches": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count_unit",
            "target_count",
            "minimum_count",
            "entries"
          ],
          "properties": {
            "count_unit": {
              "const": "instance"
            },
            "target_count": {
              "type": "integer",
              "minimum": 0
            },
            "minimum_count": {
              "type": "integer",
              "minimum": 0
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content_id",
                  "weight",
                  "value_cost"
                ],
                "properties": {
                  "content_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0
                  },
                  "value_cost": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "regionGeneration": {
      "type": "object",
      "required": [
        "layout_profiles",
        "content_profiles"
      ],
      "properties": {
        "layout_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/regionLayoutProfile"
          }
        },
        "content_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/regionContentProfile"
          }
        }
      },
      "additionalProperties": false
    },
    "corePoi": {
      "type": "object",
      "required": [
        "template_id",
